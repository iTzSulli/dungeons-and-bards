{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dungeon-bard-narrator",
  "main": "src/index.js",
  "compatibility_date": "2026-07-26",
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "NARRATOR_LIMITER",
